APP_ENV=staging-fake
GOOGLE_CLOUD_PROJECT=project-d5db8f30-7db5-4b54-925
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=devotional-movie-generation
SERVICE_BASE_URL=https://replace-after-first-cloud-run-deploy
TASK_CALLER_SERVICE_ACCOUNT=devotional-movie-task-caller@project-d5db8f30-7db5-4b54-925.iam.gserviceaccount.com
MOVIE_BUCKET=project-d5db8f30-7db5-4b54-925-devotional-movies
# Legacy single-app fallback retained for older revisions.
FIREBASE_APP_ID=1:378578536975:ios:b9e5d58b210ccf9ba6317a
# Register a Firebase Web App with App Check, then replace the placeholder. When set,
# FIREBASE_APP_IDS takes precedence over FIREBASE_APP_ID.
FIREBASE_APP_IDS=1:378578536975:ios:b9e5d58b210ccf9ba6317a,replace-with-firebase-web-app-id
# Exact scheme + host + optional port only. Never use a wildcard or trailing slash.
WEB_ALLOWED_ORIGINS=https://replace-with-web-app-origin.example,http://localhost:5173
# Required only with APP_ENV=production. The approved initial value is 1.
# MAX_PAID_VIDEO_SUBMISSIONS_PER_INDIA_DAY=1
# Select one production video provider. Secrets must come from Secret Manager, not this file.
# VIDEO_GENERATION_PROVIDER=fal
# STRUCTURED_MODEL_PROVIDER=vertex
# VERTEX_LOCATION=global
# FAL_VIDEO_PROFILE_VERSION=gemini-text-fal-ltx-preview-cheap-v1
