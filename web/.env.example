# Public Firebase web app configuration. These values identify the app; they are not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Existing Cloud Run backend origin, without a trailing slash.
VITE_BACKEND_URL=

# Disabled until the backend route has its production credit/rate/spend guard and hash recomputation.
VITE_ENABLE_ENHANCED_STILLS=false

# Local development only. Pairs with APP_ENV=local and ALLOW_INSECURE_DEVELOPMENT_AUTH=true.
VITE_USE_DEVELOPMENT_AUTH=false
