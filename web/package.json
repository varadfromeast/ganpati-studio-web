{
  "name": "ganpati-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/stage-runtime-packs.mjs && node scripts/build-service-worker.mjs && node scripts/verify-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pwa": "node scripts/stage-runtime-packs.mjs --verify && node scripts/verify-pwa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/anek-devanagari": "^5.3.0",
    "@fontsource/yatra-one": "^5.3.0",
    "firebase": "^12.18.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
